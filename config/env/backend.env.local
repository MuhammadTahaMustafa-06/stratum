# Local API — copy to backend/.env and replace placeholders (never commit backend/.env)

# LLM
GROQ_API_KEY=your-groq-api-key

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Paths (match backend/app/core/config.py defaults)
CHROMA_PERSIST_DIR=data/chroma_db
WHOOSH_INDEX_DIR=data/whoosh_index

# Models
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Auth
JWT_SECRET_KEY=change-me-min-32-chars-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=30

# Database — PostgreSQL (e.g. Neon: paste URI, use postgresql+psycopg2:// prefix)
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# App
ENVIRONMENT=development
EXPOSE_API_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=memory://
RAG_WARMUP_ON_STARTUP=true
MAX_REQUEST_SIZE_MB=10
METRICS_ENABLED=false
STRICT_AUTH_CHECKS=false
