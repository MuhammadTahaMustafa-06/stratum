# Production API — inject via Secret Manager / EC2 host env file (do not commit real values)

ENVIRONMENT=production
STRICT_AUTH_CHECKS=true

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/stratum?sslmode=require

JWT_SECRET_KEY=<from-secret-manager-min-32-chars>
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_DAYS=30

GROQ_API_KEY=<from-secret-manager>

CORS_ORIGINS=https://stratum.page
ALLOWED_HOSTS=stratum.page,api.stratum.page

CHROMA_PERSIST_DIR=/app/data/chroma_db
WHOOSH_INDEX_DIR=/app/data/whoosh_index
DATA_DIR=/app/data/raw

LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=all-MiniLM-L6-v2

EXPOSE_API_DOCS=false
MAX_REQUEST_SIZE_MB=10
METRICS_ENABLED=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability.svc.cluster.local:4317

LANGFUSE_PUBLIC_KEY=<optional>
LANGFUSE_SECRET_KEY=<optional>
LANGFUSE_HOST=https://cloud.langfuse.com

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=redis://redis:6379/0
RAG_WARMUP_ON_STARTUP=true

# Optional: user avatars in S3 (set on AWS; leave empty for local disk uploads in dev)
# S3_PUBLIC_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net
# S3_AVATAR_BUCKET=stratum-prod-avatars
# S3_AVATAR_REGION=us-east-1
# S3_AVATAR_KEY_PREFIX=avatars
# On EC2, omit keys and use an IAM instance profile with s3:PutObject / s3:DeleteObject on the bucket/prefix.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
