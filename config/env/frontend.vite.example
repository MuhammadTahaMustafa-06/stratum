# Frontend — copy to frontend/.env for local Vite dev (gitignored).
# Production: mirror these VITE_* keys into GitHub Actions secrets (see .github/workflows/deploy.yml).

# Same-origin `/api/v1` + nginx proxy in Docker; Vite dev proxy matches this.
VITE_API_BASE=/api/v1

# Neon Auth base URL (no trailing slash). Must match Console → Auth; same logical deployment as API NEON_AUTH_URL.
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# Callbacks after OAuth / reset (use your real domain in production).
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
VITE_AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Match backend AUTH_REFRESH_HTTPONLY_COOKIE (true in production).
VITE_AUTH_REFRESH_COOKIE=true
