# Production SPA build — public endpoints only; inject at `npm run build` / Docker / CI

# Prefer same-origin API path when frontend nginx proxies /api -> backend.
VITE_API_BASE=/api/v1

# Neon Auth base URL (no trailing slash), used by signup/login flows.
VITE_NEON_AUTH_URL=https://auth.stratum.example.com

# Frontend callback URLs used after auth/reset flows.
VITE_AUTH_REDIRECT_URL=https://stratum.example.com/auth/callback
VITE_AUTH_PASSWORD_RESET_REDIRECT_URL=https://stratum.example.com/reset-password

# Keep true when backend uses HttpOnly refresh cookie.
VITE_AUTH_REFRESH_COOKIE=true
